        <mxCell id="p2-s2" value="&lt;b&gt;2. Pipeline validiert&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Schema → Policies (Rego) → Cross-Refs. FAIL = präzises Feedback in &lt; 1 Min, zurück zu 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p2-1">
