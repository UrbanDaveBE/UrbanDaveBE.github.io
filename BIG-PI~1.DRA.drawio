        </mxCell>
        <mxCell id="p3-e-s3a-s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="p3-1" source="p3-s3a" target="p3-s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e-s4-s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;" edge="1" parent="p3-1" source="p3-s4" target="p3-s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-note" value="Hier wird die Registry lasttragend (P1-Prinzip): ohne gültige App-ID kein Deployment — die Identität pflegt sich ab jetzt selbst." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="p3-1">
          <mxGeometry x="240" y="770" width="900" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p4" name="P4 — Regeländerung einer Disziplin (z. B. Security)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="p4-0" />
        <mxCell id="p4-1" parent="p4-0" />
        <mxCell id="p4-title" value="P4 — Regeländerung einer Disziplin (z. B. Security)" style="text;html=1;fontSize=18;fontStyle=1;" vertex="1" parent="p4-1">
          <mxGeometry x="40" y="30" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-lane0" value="Team / Owner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=30;verticalAlign=middle;align=center;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="p4-1">
          <mxGeometry x="40" y="100" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-lanebg0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=15;" vertex="1" parent="p4-1">
          <mxGeometry x="200" y="100" width="1580" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-lane1" value="Gremium / Disziplin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=30;verticalAlign=middle;align=center;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="p4-1">
          <mxGeometry x="40" y="260" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-lanebg1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=15;" vertex="1" parent="p4-1">
          <mxGeometry x="200" y="260" width="1580" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-lane2" value="Automatik (Pipelines &amp; Jobs)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=30;verticalAlign=middle;align=center;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="p4-1">
          <mxGeometry x="40" y="420" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-lanebg2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=15;" vertex="1" parent="p4-1">
          <mxGeometry x="200" y="420" width="1580" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-lane3" value="EAM / Registry / Downstream" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=30;verticalAlign=middle;align=center;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="p4-1">
          <mxGeometry x="40" y="580" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-lanebg3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=15;" vertex="1" parent="p4-1">
          <mxGeometry x="200" y="580" width="1580" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-s1" value="&lt;b&gt;1. Disziplin ändert Regel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MR im Governance-Repo (Ableitungs- oder Qualitätsregel, mit Tests)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p4-1">
          <mxGeometry x="240" y="285" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-s2" value="&lt;b&gt;2. Impact-Analyse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pipeline rechnet: N Apps wechseln Stufe, Zusatzaufwand X&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p4-1">
          <mxGeometry x="540" y="445" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-s3" value="&lt;b&gt;3. Forum entscheidet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;domänenübergreifend: Risiko vs. Kosten. Ablehnung → zurück zu 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p4-1">
          <mxGeometry x="840" y="285" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-s4" value="&lt;b&gt;4. Merge + Neuberechnung&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ganzes Portfolio wird neu eingestuft&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p4-1">
          <mxGeometry x="1140" y="445" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-s5" value="&lt;b&gt;5. Wirkung sichtbar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;EAM-Facetten aktualisiert · Trigger (GRC) · Dashboard zeigt neue Verteilung (Scope-Creep-Metrik)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p4-1">
          <mxGeometry x="1440" y="605" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-s1-s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;" edge="1" parent="p4-1" source="p4-s1" target="p4-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-s2-s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;" edge="1" parent="p4-1" source="p4-s2" target="p4-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-s3-s1" value="abgelehnt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="p4-1" source="p4-s3" target="p4-s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-s3-s4" value="Approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;" edge="1" parent="p4-1" source="p4-s3" target="p4-s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-s4-s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;" edge="1" parent="p4-1" source="p4-s4" target="p4-s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-note" value="Einzelfall-Einstufungen brauchen kein Gremium — sie folgen mechanisch aus Fakten × Regel. Nur die Regel selbst geht durchs Forum." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="p4-1">
          <mxGeometry x="240" y="770" width="900" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p5" name="P5 — Periodische Datenbestätigung">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="p5-0" />
        <mxCell id="p5-1" parent="p5-0" />
        <mxCell id="p5-title" value="P5 — Periodische Datenbestätigung" style="text;html=1;fontSize=18;fontStyle=1;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="30" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5-lane0" value="Team / Owner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=30;verticalAlign=middle;align=center;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="100" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5-lanebg0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=15;" vertex="1" parent="p5-1">
          <mxGeometry x="200" y="100" width="1580" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5-lane1" value="Gremium / Disziplin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=30;verticalAlign=middle;align=center;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="260" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5-lanebg1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=15;" vertex="1" parent="p5-1">
          <mxGeometry x="200" y="260" width="1580" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5-lane2" value="Automatik (Pipelines &amp; Jobs)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=30;verticalAlign=middle;align=center;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="420" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5-lanebg2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=15;" vertex="1" parent="p5-1">
          <mxGeometry x="200" y="420" width="1580" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5-lane3" value="EAM / Registry / Downstream" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=30;verticalAlign=middle;align=center;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="p5-1">
          <mxGeometry x="40" y="580" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5-lanebg3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=15;" vertex="1" parent="p5-1">
          <mxGeometry x="200" y="580" width="1580" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5-s1" value="&lt;b&gt;1. Job erzeugt Ticket&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;jährlich (Krit. A: halbjährlich), mit aktuellem Datensatz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p5-1">
          <mxGeometry x="240" y="445" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5-s2" value="&lt;b&gt;2. Owner reagiert&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Bestätigen (1 Klick) ODER Korrigieren (→ MR, Prozess P2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p5-1">
          <mxGeometry x="540" y="125" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5-s3" value="&lt;b&gt;3. Vermerk gesetzt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bestaetigt_am / bestaetigt_von im EAM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p5-1">
          <mxGeometry x="840" y="445" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5-s4" value="&lt;b&gt;4. Eskalation bei Frist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;30 Tage Reminder · 60 Tage an Vorgesetzte/Architektur&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p5-1">
          <mxGeometry x="1140" y="445" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5-s5" value="&lt;b&gt;5. Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Freshness fliesst in den Qualitäts-Score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p5-1">
          <mxGeometry x="1440" y="605" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5-e-s1-s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;" edge="1" parent="p5-1" source="p5-s1" target="p5-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e-s2-s3" value="bestätigt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;" edge="1" parent="p5-1" source="p5-s2" target="p5-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e-s2-s4" value="keine Reaktion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="p5-1" source="p5-s2" target="p5-s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e-s3-s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="p5-1" source="p5-s3" target="p5-s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-e-s4-s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="p5-1" source="p5-s4" target="p5-s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5-note" value="Bestätigt wird nur, was nicht messbar ist — die Liste bestätigungspflichtiger Felder soll über die Zeit schrumpfen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="p5-1">
          <mxGeometry x="240" y="770" width="900" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
