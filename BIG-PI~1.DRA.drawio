        <mxCell id="p1-s1" value="&lt;b&gt;1. Antrag stellen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Name, Kürzel, Domäne, Owner, Kritikalität&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" parent="p1-1" vertex="1">
