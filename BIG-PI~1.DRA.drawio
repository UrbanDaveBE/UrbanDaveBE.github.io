        <mxCell id="p1-s3" value="&lt;b&gt;3. EAM-Objekt entsteht&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;APP-xxxx, Status &quot;freigegeben&quot; — einzige Stelle, wo Identität entsteht&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" parent="p1-1" vertex="1">
